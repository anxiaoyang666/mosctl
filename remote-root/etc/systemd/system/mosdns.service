[Unit]
Description=MosDNS Service
After=network.target
# 连续启动失败达到上限后单元进入 failed，才会触发 OnFailure 的救援模式。
# 不能用 StartLimitInterval=0（无限重启），否则永远到不了 failed 状态。
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=mosdns-rescue.service
[Service]
Type=simple
ExecStart=/usr/local/bin/mosdns start -d /etc/mosdns
# 启动成功后再关闭救援模式；放在 ExecStartPre 会在崩溃循环里每 3 秒拆一次救援规则。
# 放到后台执行，不再让 systemctl restart 白等 2 秒：后台子进程留在本服务的 cgroup 里，
# 2 秒内 mosdns 崩溃/被停止时整个 cgroup 会被 systemd 杀掉，救援规则不会被误拆。
ExecStartPost=-/bin/sh -c '(sleep 2; /usr/local/bin/mosctl rescue disable silent) >/dev/null 2>&1 &'
Restart=on-failure
RestartSec=3s
LimitNOFILE=65535
[Install]
WantedBy=multi-user.target
