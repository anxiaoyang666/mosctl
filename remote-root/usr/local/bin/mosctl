#!/bin/bash
# MosDNS 管理工具（版本号以 /etc/mosdns/manager/app.py 里的 PANEL_VERSION 为准）
RESCUE_DNS="223.5.5.5"
ENV_FILE="/etc/mosdns/.env"
MANAGER_APP="/etc/mosdns/manager/app.py"
# 只读取需要的键，不 source 整个文件：.env 的值来自 Web 面板，不能当作 shell 代码执行
env_get() {
    [ -f "$ENV_FILE" ] || return 0
    grep -E "^$1=" "$ENV_FILE" | tail -n 1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
}
env_has() {
    [ -f "$ENV_FILE" ] && grep -qE "^$1=" "$ENV_FILE"
}
REPO_URL="$(env_get MOSCTL_REPO_URL)"
REPO_BRANCH="$(env_get MOSCTL_BRANCH)"
REPO_BRANCH="${REPO_BRANCH:-main}"
# 代理前缀只从 .env 读：没有这个键用默认值，键存在但为空表示不走代理
if env_has GH_PROXY; then
    GH_PROXY="$(env_get GH_PROXY)"
else
    GH_PROXY="https://gh-proxy.com/"
fi
CONFIG_FILE="/etc/mosdns/config.yaml"
BACKUP_DIR="/etc/mosdns/backup"
MOSDNS_BIN="/usr/local/bin/mosdns"
# 仓库里默认配置模板的路径，mosctl sync 拉的就是这个文件
TEMPLATE_REPO_PATH="remote-root/etc/mosdns/templates/default.yaml"
LOG_FILE="/var/log/mosdns.log"
CACHE_FILE="/etc/mosdns/cache.dump"
IP_FORWARD_STATE="/etc/mosdns/.rescue-ip-forward"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
PLAIN='\033[0m'

# 面板版本：面板升级会同时覆盖 app.py 和本脚本，直接从 app.py 读就不会不同步
script_version() {
    local version=""
    if [ -f "$MANAGER_APP" ]; then
        version="$(grep -E '^PANEL_VERSION *= *"' "$MANAGER_APP" | head -n 1 | cut -d'"' -f2)"
    fi
    [ -n "$version" ] && echo "v$version" || echo "unknown"
}
SCRIPT_VER="$(script_version)"

# 内核版本直接问 mosdns 本身，不再写死在脚本里
kernel_version() {
    local version=""
    if [ -x "$MOSDNS_BIN" ]; then
        version="$("$MOSDNS_BIN" version 2>/dev/null | head -n 1)"
    fi
    [ -n "$version" ] && echo "$version" || echo "unknown"
}

# 取 "- addr: xxx # TAG_LOCAL/TAG_REMOTE" 行里的地址；兼容双引号、单引号和不带引号
# 用法：config_tag_value <配置文件> <TAG_LOCAL|TAG_REMOTE>
config_tag_value() {
    local file="$1"
    local tag="$2"
    local q="[\"']"
    [ -f "$file" ] || return 0
    grep -E "#[[:space:]]*${tag}[[:space:]]*\$" "$file" | head -n 1 \
        | sed -nE "s/^[[:space:]]*-[[:space:]]*addr:[[:space:]]*${q}?([^\"'#]*)${q}?[[:space:]]*#.*\$/\1/p" \
        | sed -E 's/[[:space:]]+$//'
}

# 把 GitHub 仓库地址转成分支里某个文件的 raw 地址；不是 GitHub 仓库时返回 1
repo_raw_url() {
    local repo="${REPO_URL%.git}"
    repo="${repo%/}"
    case "$repo" in
        https://github.com/*/*) ;;
        *) return 1 ;;
    esac
    local path="${repo#https://github.com/}"
    case "$path" in
        */*/*) return 1 ;;
    esac
    echo "https://raw.githubusercontent.com/${path}/${REPO_BRANCH}/$1"
}

# 粗略判断拉下来的是 YAML 而不是错误页：非空，且第一行非注释内容里有冒号
looks_like_yaml() {
    local first
    first="$(grep -vE '^[[:space:]]*(#|$)' "$1" 2>/dev/null | head -n 1)"
    [ -n "$first" ] && [[ "$first" == *:* ]]
}

# 转义 sed 替换串里的特殊字符（分隔符 | 以及 & 和反斜杠）
sed_escape() {
    printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'
}

# 上游地址会被写进 YAML 的双引号字符串和 # TAG 注释行，这三个字符会破坏结构
upstream_invalid() {
    case "$1" in
        *'"'*|*'\'*|*'#'*) return 0 ;;
    esac
    return 1
}

# 把直连地址转成代理地址；只处理 GitHub 域名，代理为空时原样返回
geo_url() {
    local value="$1"
    if [ -n "$GH_PROXY" ]; then
        case "$value" in
            "$GH_PROXY"*) echo "$value"; return ;;
            https://raw.githubusercontent.com/*|https://github.com/*) echo "${GH_PROXY}${value}"; return ;;
        esac
    fi
    echo "$value"
}

# 只有标准输出是终端时才显示进度；cron 里跑时进度点会把日志刷满。
# 必须带超时：GitHub 域名可能被解析成 fake-ip 交给代理，节点不可用时连接会一直挂着，
# 没有超时就永远走不到"直连失败改走 GH_PROXY"那一步，定时任务也会卡死。
WGET_TIMEOUT_OPTS=(--timeout=20 --tries=2)
wget_fetch() {
    if [ -t 1 ]; then
        wget -q "${WGET_TIMEOUT_OPTS[@]}" --show-progress --progress=dot:mega -O "$1" "$2"
    else
        wget -q "${WGET_TIMEOUT_OPTS[@]}" -O "$1" "$2"
    fi
}

# 先直连，失败再走代理
fetch_url() {
    local output="$1"
    local source="$2"
    local proxied
    if wget_fetch "$output" "$source"; then
        return 0
    fi
    proxied="$(geo_url "$source")"
    [ "$proxied" != "$source" ] || return 1
    echo -e "${YELLOW}   直连失败，改走代理重试...${PLAIN}"
    wget_fetch "$output" "$proxied"
}

rescue_enable() {
    if iptables -t nat -C PREROUTING -p udp --dport 53 -j DNAT --to-destination $RESCUE_DNS 2>/dev/null; then
        echo -e "${YELLOW}⚠️  救援模式已在运行中。${PLAIN}"
        return
    fi
    echo -e "${RED}🚑 正在启用救援模式 (转发 -> $RESCUE_DNS)...${PLAIN}"
    # 记住开启前的 ip_forward 值，关闭救援模式时恢复；系统本来就在转发（比如同时跑 mihomo）时不会被误关
    if [ ! -f "$IP_FORWARD_STATE" ]; then
        sysctl -n net.ipv4.ip_forward 2>/dev/null > "$IP_FORWARD_STATE" || rm -f "$IP_FORWARD_STATE"
    fi
    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
    iptables -t nat -A PREROUTING -p udp --dport 53 -j DNAT --to-destination $RESCUE_DNS
    iptables -t nat -A PREROUTING -p tcp --dport 53 -j DNAT --to-destination $RESCUE_DNS
    iptables -t nat -A POSTROUTING -p udp -d $RESCUE_DNS --dport 53 -j MASQUERADE
    iptables -t nat -A POSTROUTING -p tcp -d $RESCUE_DNS --dport 53 -j MASQUERADE
    echo -e "${GREEN}✅ 救援模式已开启！${PLAIN}"
}

rescue_disable() {
    if [ "$1" != "silent" ]; then echo -e "${GREEN}♻️  正在关闭救援模式...${PLAIN}"; fi
    
    # 清理防火墙规则
    iptables -t nat -D PREROUTING -p udp --dport 53 -j DNAT --to-destination $RESCUE_DNS 2>/dev/null || true
    iptables -t nat -D PREROUTING -p tcp --dport 53 -j DNAT --to-destination $RESCUE_DNS 2>/dev/null || true
    iptables -t nat -D POSTROUTING -p udp -d $RESCUE_DNS --dport 53 -j MASQUERADE 2>/dev/null || true
    iptables -t nat -D POSTROUTING -p tcp -d $RESCUE_DNS --dport 53 -j MASQUERADE 2>/dev/null || true

    # 恢复开启救援前的 ip_forward（通常是 0）；没有记录说明本次没开过，不动
    if [ -f "$IP_FORWARD_STATE" ]; then
        local previous
        previous="$(tr -cd '01' < "$IP_FORWARD_STATE" | head -c 1)"
        sysctl -w "net.ipv4.ip_forward=${previous:-0}" >/dev/null 2>&1 || true
        rm -f "$IP_FORWARD_STATE"
    fi

    # 打印切回的具体 DNS 信息
    if [ "$1" != "silent" ] && [ -f "$CONFIG_FILE" ]; then
        local local_dns remote_dns
        local_dns="$(config_tag_value "$CONFIG_FILE" TAG_LOCAL)"
        remote_dns="$(config_tag_value "$CONFIG_FILE" TAG_REMOTE)"

        echo -e "${GREEN}✅ 流量已切回正常上游配置：${PLAIN}"
        echo -e "   🏠 国内: ${GREEN}${local_dns}${PLAIN}"
        echo -e "   🌍 国外: ${GREEN}${remote_dns}${PLAIN}"
    fi
}

# 把旧配置里的 TTL / TAG_LOCAL / TAG_REMOTE 搬进新配置（和面板"恢复默认"的保留逻辑一致）
# 用法：carry_over_config_values <旧配置> <新配置>
carry_over_config_values() {
    local old="$1"
    local new="$2"
    local old_ttl old_local_dns old_remote_dns
    [ -f "$old" ] || return 0
    old_ttl="$(grep -E '^[[:space:]]*lazy_cache_ttl:' "$old" | head -n 1 | awk '{print $2}')"
    old_local_dns="$(config_tag_value "$old" TAG_LOCAL)"
    old_remote_dns="$(config_tag_value "$old" TAG_REMOTE)"

    if [[ "$old_ttl" =~ ^[0-9]+$ ]]; then
        sed -i "s/lazy_cache_ttl: [0-9]*/lazy_cache_ttl: ${old_ttl}/" "$new"
    fi
    if [ -n "$old_local_dns" ] && ! upstream_invalid "$old_local_dns"; then
        sed -i "s|\(.*\)- addr:.*# TAG_LOCAL|\1- addr: \"$(sed_escape "$old_local_dns")\" # TAG_LOCAL|" "$new"
    fi
    if [ -n "$old_remote_dns" ] && ! upstream_invalid "$old_remote_dns"; then
        sed -i "s|\(.*\)- addr:.*# TAG_REMOTE|\1- addr: \"$(sed_escape "$old_remote_dns")\" # TAG_REMOTE|" "$new"
    fi
}

# 从仓库拉取默认配置模板（remote-root/etc/mosdns/templates/default.yaml）覆盖本机 config.yaml，
# 保留当前上游 DNS 与 TTL；先直连 raw.githubusercontent.com，失败再走 GH_PROXY
sync_config() {
    if [ -z "$REPO_URL" ]; then
        echo -e "${RED}❌ 未配置 MOSCTL_REPO_URL，无法同步配置。请在 /etc/mosdns/.env 中设置你的仓库地址。${PLAIN}"
        return 1
    fi
    local source tmp backup=""
    if ! source="$(repo_raw_url "$TEMPLATE_REPO_PATH")"; then
        echo -e "${RED}❌ 只支持 GitHub 仓库在线同步，请检查 /etc/mosdns/.env 里的 MOSCTL_REPO_URL${PLAIN}"
        return 1
    fi
    echo -e "${YELLOW}☁️  正在从 GitHub 拉取默认配置模板 (${REPO_BRANCH})...${PLAIN}"
    tmp="$(mktemp)"
    if ! fetch_url "$tmp" "$source" || ! looks_like_yaml "$tmp"; then
        rm -f "$tmp"
        echo -e "${RED}❌ 拉取失败，跳过同步步骤${PLAIN}"
        return 1
    fi

    echo "⚙️  应用新配置..."
    mkdir -p /etc/mosdns "$BACKUP_DIR"
    if [ -f "$CONFIG_FILE" ]; then
        # 和面板一样放进 backup/ 并用 config.<stamp>.bak 命名，面板的备份列表能看到并按保留数清理
        backup="$BACKUP_DIR/config.$(date +%Y%m%d%H%M%S).bak"
        cp -a "$CONFIG_FILE" "$backup"
        carry_over_config_values "$CONFIG_FILE" "$tmp"
    fi
    install -m 0644 "$tmp" "$CONFIG_FILE"
    rm -f "$tmp"

    if ! systemctl list-units --full -all | grep -q "mosdns.service"; then
        echo -e "${GREEN}✅ 初始配置已写入。 (等待服务启动)${PLAIN}"
        return 0
    fi
    echo "🔄 重启服务..."
    systemctl reset-failed mosdns 2>/dev/null
    systemctl restart mosdns 2>/dev/null || true
    sleep 1
    if systemctl is-active --quiet mosdns; then
        echo -e "${GREEN}✅ 同步成功！(已保留当前上游 DNS 与 TTL)${PLAIN}"
        [ -n "$backup" ] && echo "   同步前配置已备份到：$backup"
        return 0
    fi
    echo -e "${RED}❌ 启动失败！自动回滚...${PLAIN}"
    if [ -n "$backup" ] && [ -f "$backup" ]; then
        cp -a "$backup" "$CONFIG_FILE"
        systemctl restart mosdns
    fi
    return 1
}

change_upstream() {
    local type=$1
    local tag_marker=$2
    local default_proto=$3
    echo -e "\n${YELLOW}📝 修改 [$type] DNS 上游${PLAIN}"
    grep "$tag_marker" $CONFIG_FILE | grep -v "grep"
    if [ -t 0 ]; then read -p "地址: " new_ip; else echo -n "地址: "; read new_ip < /dev/tty; fi
    if [ -z "$new_ip" ]; then echo "已取消"; return; fi
    if upstream_invalid "$new_ip"; then echo -e "${RED}❌ 地址不能包含双引号、反斜杠或 #${PLAIN}"; return 1; fi
    if [[ -n "$default_proto" ]] && [[ "$new_ip" != *"://"* ]]; then new_ip="${default_proto}://${new_ip}"; fi
    sed -i "s|\(.*\)- addr:.*$tag_marker|\1- addr: \"$(sed_escape "$new_ip")\" $tag_marker|" $CONFIG_FILE
    systemctl restart mosdns && echo -e "${GREEN}✅ 修改成功！${PLAIN}"
}

change_cache_ttl() {
    local new_ttl=$1
    if [ -z "$new_ttl" ]; then
        echo -e "\n${YELLOW}⏱️  修改 DNS 缓存时间 (TTL)${PLAIN}"
        echo "当前配置: $(grep "lazy_cache_ttl" $CONFIG_FILE | awk '{print $2}') 秒"
        if [ -t 0 ]; then read -p "请输入新的缓存时间 (秒): " new_ttl; else echo -n "请输入新的缓存时间 (秒): "; read new_ttl < /dev/tty; fi
    fi
    if [[ ! "$new_ttl" =~ ^[0-9]+$ ]]; then echo -e "${RED}❌ 错误：TTL 必须是数字${PLAIN}"; return 1; fi
    echo "修改缓存时间为: ${new_ttl} 秒"
    sed -i "s/lazy_cache_ttl: [0-9]*/lazy_cache_ttl: ${new_ttl}/" $CONFIG_FILE
    systemctl restart mosdns && echo -e "${GREEN}✅ 缓存时间已修改！${PLAIN}"
}

run_test() {
    echo -e "\n${YELLOW}🩺 正在进行 DNS 解析诊断 (检查 IP 类型)...${PLAIN}"
    check_domain() {
        local domain=$1
        local label=$2
        echo -n "  Testing $label ($domain) ... "
        local start_time=$(date +%s%3N)
        local result=$(nslookup "$domain" 127.0.0.1 2>&1)
        local exit_code=$?
        local duration=$(($(date +%s%3N) - start_time))

        if [ $exit_code -eq 0 ]; then
            local ip=$(echo "$result" | grep "Address:" | grep -v "#53" | grep -v "127.0.0.1" | grep -v "::1" | awk '{print $2}' | head -n 1)
            if [ -z "$ip" ]; then ip=$(echo "$result" | tail -n 2 | grep -E -o "([0-9]{1,3}[\.]){3}[0-9]{1,3}" | head -n 1); fi
            echo -e "${GREEN}✅ Pass (${duration}ms)${PLAIN} -> IP: ${YELLOW}${ip}${PLAIN}"
        else
            echo -e "${RED}❌ Failed (Timeout)${PLAIN}"
        fi
    }
    check_domain "www.baidu.com" "🇨🇳 国内"
    check_domain "www.google.com" "🌍 国外"
    echo ""
}

edit_rule() {
    local file=$1
    echo "路径: $file"
    read -p "按回车键开始编辑..." < /dev/tty
    nano "$file"
    systemctl restart mosdns && echo -e "${GREEN}✅ 规则已应用。${PLAIN}"
}

# config.yaml 里 api.http 的监听地址，转成本机能访问的 host:port；没有 api 段输出空
config_api_addr() {
    local listen
    listen="$(grep -E '^[[:space:]]*http:' "$CONFIG_FILE" 2>/dev/null | head -n 1 \
        | sed -nE "s/^[[:space:]]*http:[[:space:]]*[\"']?([^\"'#]*)[\"']?[[:space:]]*\$/\1/p" | sed -E 's/[[:space:]]+$//')"
    case "$listen" in
        "") ;;
        :*) echo "127.0.0.1${listen}" ;;
        0.0.0.0:*) echo "127.0.0.1:${listen#0.0.0.0:}" ;;
        "[::]:"*) echo "127.0.0.1:${listen#\[::\]:}" ;;
        *) echo "$listen" ;;
    esac
}

# 第一个 type: cache 插件的 tag
config_cache_tag() {
    grep -E '^[[:space:]]*(- tag:|type:)' "$CONFIG_FILE" 2>/dev/null \
        | awk '/- tag:/ {tag=$3} /type:[[:space:]]*"?cache"?[[:space:]]*$/ {gsub(/["'"'"']/, "", tag); print tag; exit}'
}

http_get_ok() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsS -m 5 -o /dev/null "$1"
    else
        wget -q -T 5 -O /dev/null "$1"
    fi
}

flush_cache() {
    # mosdns 的 cache 插件提供 GET /plugins/<tag>/flush，不用重启；API 不通时才删 dump 文件重启
    local api tag
    api="$(config_api_addr)"
    tag="$(config_cache_tag)"
    if [ -n "$api" ] && [ -n "$tag" ] && http_get_ok "http://${api}/plugins/${tag}/flush"; then
        echo -e "${GREEN}✅ 缓存已通过 API 清空（无需重启）${PLAIN}"
        return 0
    fi
    echo -e "${YELLOW}API 清缓存不可用，改为删除缓存文件并重启 mosdns...${PLAIN}"
    rm -f "$CACHE_FILE"
    systemctl reset-failed mosdns 2>/dev/null
    systemctl restart mosdns && echo -e "${GREEN}✅ 缓存已清空！${PLAIN}"
}

# === 1. 服务管理子菜单 ===
service_menu() {
    clear
    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e "${GREEN}       ⚙️  MosDNS 服务管理           ${PLAIN}"
    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e "  1. ▶️  启动服务 (Start)"
    echo -e "  2. ⏹️  停止服务 (Stop)"
    echo -e "  3. 🔄  重启服务 (Restart)"
    echo -e "  0. 🔙  返回主菜单"
    echo -e "${GREEN}=====================================${PLAIN}"
    
    if [ -t 0 ]; then read -p "请选择: " sub_choice; else echo -n "请选择: "; read sub_choice < /dev/tty; fi
    
    case "$sub_choice" in
        1) systemctl start mosdns && echo -e "${GREEN}✅ 服务已启动！${PLAIN}" ;;
        2) systemctl stop mosdns && echo -e "${RED}🛑 服务已停止！${PLAIN}" ;;
        3) systemctl restart mosdns && echo -e "${GREEN}✅ 服务已重启！${PLAIN}" ;;
        0) return ;;
        *) echo -e "${RED}无效选项${PLAIN}" ;;
    esac
}

# === 3. DNS 参数设置子菜单 (整合了上游/TTL/缓存清理) ===
dns_settings_menu() {
    clear
    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e "${GREEN}       ⚙️  DNS 参数设置              ${PLAIN}"
    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e "  1. 📡  修改上游 DNS (Upstream)"
    echo -e "  2. ⏱️  设置缓存 TTL (Cache Time)"
    echo -e "  3. 🧹  清空 DNS 缓存 (Flush)"
    echo -e "  0. 🔙  返回主菜单"
    echo -e "${GREEN}=====================================${PLAIN}"
    
    if [ -t 0 ]; then read -p "请选择: " sub_choice; else echo -n "请选择: "; read sub_choice < /dev/tty; fi
    
    case "$sub_choice" in
        1) upstream_menu ;;
        2) change_cache_ttl ;;
        3) flush_cache ;;
        0) return ;;
        *) echo -e "${RED}无效选项${PLAIN}" ;;
    esac
}

# 上游设置子项 (原 config_menu)
upstream_menu() {
    echo -e "\n${GREEN}--- 修改上游 DNS ---${PLAIN}"
    echo -e "  1. 🇨🇳 修改国内 DNS (默认补全 udp://)"
    echo -e "  2. 🌍 修改国外 DNS (不强制补全)"
    echo -e "  0. 🔙 返回"
    if [ -t 0 ]; then read -p "请选择: " uc; else echo -n "请选择: "; read uc < /dev/tty; fi
    case "$uc" in
        1) change_upstream "国内" "# TAG_LOCAL" "udp" ;;
        2) change_upstream "国外" "# TAG_REMOTE" "" ;;
        0) return ;;
    esac
}

# === 6. 救援模式子菜单 (整合了开启/关闭) ===
rescue_menu() {
    clear
    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e "${GREEN}       🚑  救援模式管理              ${PLAIN}"
    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e "  1. ✅  开启救援模式 (强制转发 -> 223.5.5.5)"
    echo -e "  2. ⏹️  关闭救援模式 (恢复正常)"
    echo -e "  0. 🔙  返回主菜单"
    echo -e "${GREEN}=====================================${PLAIN}"
    
    if [ -t 0 ]; then read -p "请选择: " sub_choice; else echo -n "请选择: "; read sub_choice < /dev/tty; fi
    
    case "$sub_choice" in
        1) rescue_enable ;;
        2) rescue_disable ;;
        0) return ;;
        *) echo -e "${RED}无效选项${PLAIN}" ;;
    esac
}

rules_menu() {
    clear
    echo "  1. 🏠 自定义 Hosts"
    echo "  2. 🇨🇳 强制走国内 (域名)"
    echo "  3. 🌍 强制走国外 (域名)"
    if [ -t 0 ]; then read -p "请选择: " sub_choice; else echo -n "请选择: "; read sub_choice < /dev/tty; fi
    case "$sub_choice" in
        1) edit_rule "/etc/mosdns/rules/hosts.txt" ;;
        2) edit_rule "/etc/mosdns/rules/force-cn.txt" ;;
        3) edit_rule "/etc/mosdns/rules/force-nocn.txt" ;;
    esac
}

# 结尾固定打印「===== 结果: 成功/失败 =====」，面板从 /var/log/mosctl-update.log 里读这一行判断上次结果
update_geo_rules() {
    echo "===== $(date '+%F %T') 更新 Geo 规则 ====="
    if do_update_geo_rules; then
        echo "===== 结果: 成功 ====="
        return 0
    fi
    echo -e "${RED}❌ 规则更新失败${PLAIN}"
    echo "===== 结果: 失败 ====="
    return 1
}

do_update_geo_rules() {
    echo -e "${YELLOW}⬇️  正在更新 GeoSite...${PLAIN}"
    mkdir -p /etc/mosdns/rules
    # 旧版本会下载 geoip_cn / geosite_apple 并带着 user_iot / local-ptr，但配置从未引用它们；顺手清掉
    rm -f /etc/mosdns/rules/geoip_cn.txt /etc/mosdns/rules/geosite_apple.txt \
          /etc/mosdns/rules/user_iot.txt /etc/mosdns/rules/local-ptr.txt \
          /etc/mosdns/rules/*.save /etc/mosdns/rules/*.save.*
    dl() {
        local target="$1"
        local source="$2"
        local tmp
        tmp=$(mktemp "${target}.tmp.XXXXXX")
        echo " - $(basename "$target")"
        if fetch_url "$tmp" "$source"; then
            mv "$tmp" "$target"
        else
            rm -f "$tmp"
            echo -e "${RED}❌ 下载失败：${source}${PLAIN}"
            return 1
        fi
    }
    # 只下载 config.yaml 实际引用的两个列表
    dl "/etc/mosdns/rules/geosite_cn.txt" "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/direct-list.txt" || return 1
    dl "/etc/mosdns/rules/geosite_no_cn.txt" "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/proxy-list.txt" || return 1
    systemctl reset-failed mosdns 2>/dev/null
    systemctl restart mosdns || return 1
    echo -e "${GREEN}✅ 规则更新完毕！${PLAIN}"
}

view_logs() {
    tail -n 50 -f "$LOG_FILE"
}

uninstall_mosdns() {
    if [ -t 0 ]; then read -p "⚠️  高危操作：确定要彻底卸载 MosDNS 及面板吗？(y/n): " confirm; else echo -n "⚠️  高危操作：确定要彻底卸载 MosDNS 及面板吗？(y/n): "; read confirm < /dev/tty; fi
    if [ "$confirm" == "y" ]; then
        echo "⏳ 正在停止服务..."
        systemctl stop mosdns 2>/dev/null || true
        systemctl stop mosdns-rescue 2>/dev/null || true
        systemctl stop mosdns-web 2>/dev/null || true
        
        echo "🚫 禁用服务..."
        systemctl disable mosdns 2>/dev/null || true
        systemctl disable mosdns-rescue 2>/dev/null || true
        systemctl disable mosdns-web 2>/dev/null || true
        
        echo "🗑️  清理文件..."
        rm -f /etc/systemd/system/mosdns.service
        rm -f /etc/systemd/system/mosdns-rescue.service
        rm -f /etc/systemd/system/mosdns-web.service
        rm -f /etc/sysctl.d/99-mosdns.conf
        rm -f /etc/logrotate.d/mosdns
        systemctl daemon-reload
        
        rm -rf /etc/mosdns
        rm -f /usr/local/bin/mosdns
        rm -f /usr/local/bin/mosdns-web
        rm -f /var/log/mosdns.log /var/log/mosctl-update.log
        
        crontab -l 2>/dev/null | grep -v "mosctl update" | crontab -

        # 只在 resolv.conf 是普通文件且指向本机时才改写；
        # systemd-resolved / NetworkManager 管理的符号链接由它们自己维护，改了也会被覆盖
        if [ -L /etc/resolv.conf ]; then
            echo "ℹ️  /etc/resolv.conf 是符号链接（由 systemd-resolved/NetworkManager 等管理），未改动，请自行确认 DNS 设置。"
        elif grep -qE '^[[:space:]]*nameserver[[:space:]]+127\.0\.0\.1' /etc/resolv.conf 2>/dev/null; then
            echo "nameserver 223.5.5.5" > /etc/resolv.conf
            echo "ℹ️  /etc/resolv.conf 原指向 127.0.0.1，已改为 223.5.5.5。"
        else
            echo "ℹ️  /etc/resolv.conf 未指向本机，保持不变。"
        fi

        rm -f /usr/local/bin/mosctl
        echo -e "${GREEN}✅ 卸载完成。系统已清理干净。\033[0m"
        exit 0
    fi
}

show_menu() {
    clear
    local status_raw=$(systemctl is-active mosdns 2>/dev/null)
    local status_text=""
    local kernel_ver
    kernel_ver="$(kernel_version)"
    if [ "$status_raw" == "active" ]; then status_text="${GREEN}🟢 运行中${PLAIN}"; else status_text="${RED}🔴 未运行${PLAIN}"; fi

    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e "${GREEN}      MosDNS 管理面板 (${SCRIPT_VER})      ${PLAIN}"
    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e " 内核版本: ${GREEN}${kernel_ver}${PLAIN} | 状态: $status_text"
    echo -e "${GREEN}=====================================${PLAIN}"
    echo -e "   1. 🛠️  服务管理 (启动/停止/重启)"
    echo -e "   2. 🔄  同步配置 (拉取仓库默认模板，保留上游/TTL)"
    echo -e "   3. ⚙️  DNS 参数设置 (上游/缓存/TTL)"
    echo -e "   4. 📝  管理自定义规则"
    echo -e "   5. ⬇️  更新 Geo 数据"
    echo -e "   6. 🚑  救援模式管理"
    echo -e "   7. 📊  查看运行日志"
    echo -e "   8. 🩺  DNS 解析测试"
    echo -e "   9. 🗑️  彻底卸载"
    echo -e "   0. 🚪  退出"
    echo -e "${GREEN}=====================================${PLAIN}"
    echo
    if [ -t 0 ]; then read -p "请选择: " choice; else echo -n "请选择: "; read choice < /dev/tty; fi

    case "$choice" in
        1) service_menu ;;
        2) sync_config ;;
        3) dns_settings_menu ;;
        4) rules_menu ;;
        5) update_geo_rules ;;
        6) rescue_menu ;;
        7) view_logs ;;
        8) run_test; read -p "按回车继续..." < /dev/tty ;;
        9) uninstall_mosdns ;;
        0) exit 0 ;;
        *) echo -e "${RED}无效${PLAIN}" ;;
    esac
    if [[ "$choice" != "7" && "$choice" != "8" ]]; then read -p "按回车键返回..." < /dev/tty; show_menu; fi
}

if [ $# -gt 0 ]; then
    case "$1" in
        rescue)
            if [ "$2" == "enable" ]; then rescue_enable; elif [ "$2" == "disable" ]; then rescue_disable; else echo "Usage: mosctl rescue {enable|disable}"; fi ;;
        sync) sync_config ;;
        update) update_geo_rules; exit $? ;;
        flush) flush_cache; exit $? ;;
        cache-ttl) change_cache_ttl "$2" ;;
        test) run_test ;;
        version) echo "$SCRIPT_VER" ;;
        *) echo "Usage: mosctl [rescue|sync|update|flush|cache-ttl|test|version]" ;;
    esac
else
    show_menu
fi
