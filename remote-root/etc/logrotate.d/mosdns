# mosdns 自己写 /var/log/mosdns.log（config.yaml 的 log.file），不会响应 SIGHUP 重新打开文件，
# 所以用 copytruncate；mosctl-update.log / mosctl-auto-update.log 是定时任务的追加输出，mosctl-notify.log 是通知发送记录。
/var/log/mosdns.log /var/log/mosctl-update.log /var/log/mosctl-auto-update.log /var/log/mosctl-notify.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
